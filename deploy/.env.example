# Production settings: copy to deploy/.env on the server and fill in.
# Never commit deploy/.env.
#
# docker compose reads this file, and the scripts in deploy/ load it with
# bash: put a value with spaces, < or > in double quotes, and use passwords
# of letters and digits only (openssl rand -hex 24), since the database
# password also goes into a URL.
#
# The API gets every line of this file in its environment, so any setting
# of api/app/settings.py can be changed here too (RATE_LIMIT_AUTH=...).

# ---- images (deploy/scripts/deploy.sh pulls them) ----
# <Docker Hub user>/caramelcase-api and -web, as the build workflow names them.
DOCKER_IMAGE_API=youruser/caramelcase-api
DOCKER_IMAGE_WEB=youruser/caramelcase-web
DOCKER_TAG=main

# ---- domain, nginx, certbot ----
DOMAIN=example.com
# default.conf.https in production; default.conf.http on a laptop, or on a
# server before its first certificate.
NGINX_CONF_FILE=default.conf.https
HTTP_PORT=80
HTTPS_PORT=443
# Let's Encrypt writes here about the certificate.
CERTBOT_EMAIL=
# Where the repository is cloned on the server; the cron jobs use it.
PROJECT_ROOT=/opt/caramelcase

# ---- Postgres ----
POSTGRES_USER=caramel
POSTGRES_PASSWORD=
POSTGRES_DB=caramelcase

# ---- backups (deploy/backup.sh) ----
BACKUP_DIR=/var/backups/caramelcase
BACKUP_KEEP=14

# ---- API ----
APP_BASE_URL=https://example.com
CORS_ORIGINS=https://example.com
SESSION_COOKIE_SECURE=true
LOG_LEVEL=INFO
GUNICORN_WORKERS=2

# Google sign-in. Empty: no Google button. Register
# <APP_BASE_URL>/api/v1/auth/google/callback as a redirect URI at Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign-in emails. Empty SMTP_HOST: emails go to the API's log, and nobody
# can sign in by email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM="CaramelCase <no-reply@example.com>"

# ---- optional services: each is off while its value is empty ----
# Error tracking for the API: the DSN of a Better Stack error tracking
# application (its Ingest tab).
BETTER_STACK_ERRORS_DSN=
# The web app's keys are built into its image, so they are set where the
# image is built: as secrets of the build workflow (docs/RUNBOOK.md), or
# here for `make build` on a laptop.
VITE_BETTER_STACK_ERRORS_DSN=
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_SCRIPT=
