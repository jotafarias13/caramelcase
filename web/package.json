{
  "name": "caramelcase-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --ssr src/prerender.tsx --outDir dist-ssr && vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "eslint --fix . && prettier --write .",
    "typecheck": "tsc -b && npm run types:check",
    "types": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts",
    "types:check": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts --check",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "shots": "playwright test -c shots/playwright.config.ts",
    "icons": "node scripts/export-icons.mjs"
  },
  "dependencies": {
    "@sentry/browser": "^11.14.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^27.1.5",
    "lucide-react": "^1.73.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.2",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12"
  }
}
