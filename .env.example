# Copy to .env to change a value. Nothing here is required for local
# development: docker-compose.yml has a default for each one.
# Never commit a real .env.

# ---- Postgres (docker compose) ----
POSTGRES_USER=caramel
POSTGRES_PASSWORD=caramel
POSTGRES_DB=caramelcase
POSTGRES_PORT=5432

# ---- ports on the host ----
API_PORT=8000
WEB_PORT=5173

# ---- API ----
# The API reads these from its environment (api/app/settings.py). Under
# docker compose, DATABASE_URL is built from the Postgres values above.
# Every tunable in settings.py can be overridden the same way, for example
# SESSION_LENGTH=5.
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://caramel:caramel@localhost:5432/caramelcase
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
LOG_JSON=false

# The web app's public address: the start of the links in emails and of
# the address Google sends the student back to.
APP_BASE_URL=http://localhost:5173
# The session cookie is Secure, except in local development over http,
# where docker-compose.yml turns it off. Keep it true in production.
SESSION_COOKIE_SECURE=true

# ---- Google sign-in ----
# Empty: local development uses a mock that signs in as the demo user,
# and production has no Google button. The redirect URI to register at
# Google is <APP_BASE_URL>/api/v1/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- email (sign-in links) ----
# Without SMTP_HOST, emails are written to the API's log instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=CaramelCase <no-reply@localhost>
